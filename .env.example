# Postgres URLs (read-only live) — pelo menos uma para modo live
#
# Brasil: Supabase pooler (NÃO use Neon ep-long-sun — BR Neon morto)
#   Session :5432  ou  Transaction :6543
#   host: aws-*-pooler.supabase.com  |  sslmode=require
#   Client postgres.js: ssl:'require' + prepare:false
#   Guard: npm run check:brasil-db-host
# Nome da env permanece NEON_BRASIL_* por compat Vercel; o valor é Supabase.
NEON_BRASIL_DATABASE_URL=

# Iguatemi: Neon (permanece Neon — não apontar para Supabase)
NEON_IGUATEMI_DATABASE_URL=

# Neon exclusivo do Cérebro — snapshots/relatórios (CSV/XLSX sob demanda)
# CEREBRO_DATABASE_URL=

# Auth Waltter (obrigatório em produção)
CEREBRO_ADMIN_USER=waltter
CEREBRO_ADMIN_PASSWORD=
# Opcional — secret dedicado da sessão (recomendado). Sem isso, usa a senha admin.
# CEREBRO_SESSION_SECRET=

# Sentry (Next.js) — projeto rom-cerebro na org imobi-hl
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Resend — alertas de saúde por e-mail (severidade crítica)
# Pode reutilizar a mesma RESEND_API_KEY dos projetos ROM
RESEND_API_KEY=
ALERT_EMAIL_TO=contato.vinicaetano93@gmail.com
# Opcional — remetente (precisa de domínio verificado no Resend; senão usa onboarding@resend.dev)
# RESEND_FROM=Cérebro ROM <onboarding@resend.dev>

# Forçar mock mesmo com URLs configuradas
# CEREBRO_FORCE_MOCK=1

# Metas e capacidade — preferir preencher no painel (Metas).
# Env só como bootstrap opcional se a tabela cerebro_goals ainda estiver vazia.
# BRASIL_DAILY_GOAL=
# BRASIL_DAILY_CAPACITY=
# IGUATEMI_DAILY_GOAL=
# IGUATEMI_DAILY_CAPACITY=
